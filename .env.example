# Copy to .env and fill in. `.env` is git-ignored; this file is not.
# Only the scripts in scripts/download/ read these; the library itself needs none.

# nLine GridWatch (Ghana). Free key: https://nline.io/public-data
# Used by scripts/download/gridwatch_ghana.py
NLINE_API_KEY=

# Copernicus Climate Data Store (ERA5). Key: https://cds.climate.copernicus.eu/how-to-api
# Accept the dataset's terms of use on its page first, or requests are refused.
# Used by scripts/download/era5_west_africa.py (read by the cdsapi client)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# NASA Earthdata bearer token (VIIRS VNP46). Create one at https://urs.earthdata.nasa.gov
# under "Generate Token"; it expires, so regenerate when downloads return 401.
# Used by scripts/download/viirs_vnp46_ghana.py
EARTHDATA_TOKEN=
